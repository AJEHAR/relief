rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // Senarai emel admin permulaan — KEKALKAN SAMA dgn BOOTSTRAP_ADMIN_EMAILS
    // dalam js/firebase-config.js. Perlu untuk selesaikan masalah "ayam & telur":
    // profil pengguna belum wujud lagi semasa first-login, jadi isAdmin() di atas
    // tak boleh disemak — rule ni benarkan create SEBAGAI admin terus untuk emel
    // yang disenaraikan sahaja.
    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'azharuddinhaniff@gmail.com'
      ];
    }

    // ── Data awam (boleh baca semua) — hanya admin boleh tulis ──
    match /teachers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /masterTimetable/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /dailyBoard/{date} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reliefRecords/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Pengguna ──
    match /users/{uid} {
      // Sesiapa yang log masuk boleh baca senarai pengguna (perlu utk semak role sendiri
      // & panel Pengurusan Pengguna admin memaparkan senarai).
      allow read: if isSignedIn();

      // Pengguna cipta profil sendiri sekali sahaja (first login), TIDAK boleh
      // tetapkan role sendiri jadi 'admin' — kecuali emel dia dalam senarai
      // isBootstrapAdmin() (utk elak masalah "ayam & telur" admin pertama),
      // atau sedia ada admin lain yang buat panggilan (jarang berlaku sebab
      // create hanya utk uid sendiri).
      allow create: if isSignedIn() && request.auth.uid == uid
                    && (
                         request.resource.data.role == 'pending'
                         || (request.resource.data.role == 'admin' && isBootstrapAdmin())
                       );

      // Update field 'teacherId' — pengguna sendiri sahaja (pautan nama guru, ggview).
      allow update: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherId']);

      // Update field 'role' — admin sahaja.
      allow update: if isAdmin();

      // Padam — admin boleh padam sesiapa; pengguna boleh padam profil sendiri
      // (cth: bersihkan akaun pendaftaran berganda/silap).
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }
  }
}
